{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "venv",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/generateRecipe",
        "function": "generate_recipe"
      },
      {
        "source": "/api/ingredients/search",
        "function": "search_ingredients"
      },
      {
        "source": "/api/ingredients/update",
        "function": "update_ingredient"
      },
      {
        "source": "/api/ingredients",
        "function": "add_ingredient"
      },
      {
        "source": "/api/ingredient-list/add",
        "function": "add_to_ingredient_list"
      },
      {
        "source": "/api/ingredient-list/remove",
        "function": "remove_from_ingredient_list"
      },
      {
        "source": "/api/ingredient-list",
        "function": "get_ingredient_list"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ]
  }
}