rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // US-1, US-7: Users can read/write their own profile data (including ingredient_list)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // US-6: Favorites subcollection
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // US-4: Diet rules are read-only for authenticated users
    match /diet_rules/{ruleId} {
      allow read: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}